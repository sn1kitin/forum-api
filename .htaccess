<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On
    RewriteBase /forum-api/

    # Deze mappen en bestanden mogen niet van buitenaf bereikbaar zijn
    RewriteRule ^(app|vendor)(/|$) - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]

    # http://localhost/forum-api/threads/1/topics
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ index.php?resource=$1&id=$2&relation=$3 [L,QSA]

    # http://localhost/forum-api/threads/1
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)/([^/]+)/?$ index.php?resource=$1&id=$2 [L,QSA]

    # http://localhost/forum-api/threads
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)/?$ index.php?resource=$1 [L,QSA]

    # alle andere urls, dan geeft de api zelf een 404
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)$ index.php?resource=$1 [L,QSA]
</IfModule>
